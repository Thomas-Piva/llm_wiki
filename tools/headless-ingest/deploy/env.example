# llm_wiki headless ingest — service environment.
# Copy to ~/.config/llm-wiki-headless/env and `chmod 600` (it holds the key).
#
# IMPORTANT: systemd EnvironmentFile does NOT expand %h or ~ — use ABSOLUTE paths.

# Project to ingest (must contain raw/sources/, wiki/, schema.md, purpose.md).
PROJECT=/home/USER/headless-vps

# Ingest is I/O-bound; 1 is VPS-safe. Raise on a beefy box for bulk backfill.
CONCURRENCY=1

# Park sources larger than this (leave pending for a bigger-limit run).
MAX_SIZE=50M

# Provider — hydrated into the wiki-store exactly like the desktop app.
# Use a NON-REASONING model: reasoning models can return empty content and
# lose the page (e.g. deepseek-v4-flash). deepseek-chat-v3-0324 is a safe default.
HEADLESS_LLM_PROVIDER=custom
HEADLESS_LLM_MODEL=deepseek/deepseek-chat-v3-0324
HEADLESS_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
HEADLESS_LLM_API_KEY=sk-or-REPLACE-ME

# Alternatively, drop the HEADLESS_LLM_* lines and point at the desktop app's
# real config instead (zero reconfig): add `--config /abs/app-state.json` to the
# service ExecStart. The active preset / ingest routing is then honoured.
